# Variaveis consumidas pelo docker-compose.yml (nada aqui e secreto por natureza,
# mas MONGO_PASSWORD e SESSION_ID sao: use um .env local, nunca commite o .env real).
#
# Gere a senha do mongo com: openssl rand -hex 24
MONGO_USER=atlas
MONGO_PASSWORD=
# SESSION_ID: id da sessao Baileys. Com MONGODB configurado, a sessao fica persistida
# na colecao do Mongo (AuthDB/SessionSchema) e sobrevive a reinicios do container.
SESSION_ID=
# Prefixo dos comandos do bot
PREFIX=-
# Modulos/moderadores habilitados (lista separada por virgula, conforme o upstream)
MODS=
# Onde o painel (porta 10000 do container) e publicado no host.
# 127.0.0.1 = so local; use 0.0.0.0 ou o IP do host quando houver proxy em outra maquina.
PANEL_BIND=127.0.0.1
PANEL_PORT=10000
